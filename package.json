{
  "name": "photon-customer-support",
  "version": "2.0.0",
  "description": "General-purpose AI-powered iMessage customer support platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:agent": "bun run packages/agent/src/index.ts",
    "dev:agent": "bun --watch packages/agent/src/index.ts",
    "start:dashboard": "cd packages/dashboard && npm run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "imessage",
    "ai",
    "customer-support",
    "chatbot",
    "general-purpose"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
