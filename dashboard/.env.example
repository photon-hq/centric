# Dashboard-specific environment variables

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model Configuration (defaults shown)
MODEL=gpt-5-mini
TEMPERATURE=1
MAX_COMPLETION_TOKENS=5000

# Company Configuration
NEXT_PUBLIC_COMPANY_NAME=Photon
NEXT_PUBLIC_COMPANY_INDUSTRY=Customer Support AI
NEXT_PUBLIC_COMPANY_DESCRIPTION=AI-powered customer support for modern businesses
NEXT_PUBLIC_COMPANY_WEBSITE=photon.com
NEXT_PUBLIC_COMPANY_PHONE=1-800-PHOTON
NEXT_PUBLIC_COMPANY_EMAIL=support@photon.com
NEXT_PUBLIC_COMPANY_GREETING="Hello! I'm the Photon AI Assistant. I can help you with product questions, support issues, and more. How can I help you today?"
