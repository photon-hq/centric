{
  "negotiation": {
    "enabled": true,
    "defaultDiscount": 0.15,
    "maxDiscount": 0.25,
    "requiresApproval": false
  },
  "mcp": {
    "enabled": true
  },
  "sops": {
    "enabled": true,
    "autoLoad": true,
    "source": "config/sops.json"
  },
  "knowledgeBase": {
    "enabled": true,
    "documentsPath": "./documents",
    "maxResults": 7,
    "similarityThreshold": 0.4
  },
  "timeConstraints": {
    "offerValidityHours": 24,
    "responseTimeMinutes": 60
  }
}
